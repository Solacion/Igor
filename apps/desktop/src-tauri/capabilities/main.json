{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may read status and control its core session. Tool execution remains in the core.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-desktop-status",
    "allow-start-session",
    "allow-send-message",
    "allow-resolve-approval",
    "allow-answer-clarification",
    "allow-cancel-turn",
    "allow-close-session"
  ]
}
