{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may read desktop/core version metadata and manage MCP servers in Settings.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-desktop-status",
    "allow-settings-view",
    "allow-settings-save-server",
    "allow-settings-test-server",
    "allow-settings-remove-server",
    "allow-settings-reconnect-server",
    "allow-settings-set-permission",
    "allow-start-session",
    "allow-send-message",
    "allow-resolve-approval",
    "allow-answer-clarification",
    "allow-cancel-turn",
    "allow-close-session",
    "allow-export-activity",
    "allow-conversation-providers"
  ]
}
