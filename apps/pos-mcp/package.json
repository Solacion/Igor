    "mssql": "12.7.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
