{
  "server": {
    "name": "igor-fixture-weather",
    "version": "0.1.0"
  },
  "tools": [
    {
      "name": "get_forecast",
      "title": "Weather forecast",
      "description": "Daily weather forecast for one location over an inclusive date range of at most 7 days.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "title": "Location",
            "description": "Location identifier, for example brighton-uk.",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "First forecast day (YYYY-MM-DD), inclusive.",
            "title": "From"
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Last forecast day (YYYY-MM-DD), inclusive.",
            "title": "To"
          }
        },
        "required": [
          "location",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "timezone": {
                "type": "string",
                "description": "IANA time zone of the daily values."
              }
            },
            "required": [
              "id",
              "name",
              "timezone"
            ]
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "units": {
            "type": "object",
            "properties": {
              "temperature": {
                "type": "string",
                "const": "celsius"
              },
              "precipitation": {
                "type": "string",
                "const": "mm"
              }
            },
            "required": [
              "temperature",
              "precipitation"
            ]
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "temperature_max": {
                  "type": "number"
                },
                "temperature_min": {
                  "type": "number"
                },
                "precipitation": {
                  "type": "number",
                  "minimum": 0
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "date",
                "temperature_max",
                "temperature_min",
                "precipitation",
                "summary"
              ]
            }
          }
        },
        "required": [
          "location",
          "from",
          "to",
          "units",
          "days"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    }
  ],
