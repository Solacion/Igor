{
  "server": {
    "name": "igor-fixture-sales",
    "version": "0.1.0"
  },
  "tools": [
    {
      "name": "get_stock_levels",
      "title": "Stock levels",
      "description": "Stock on hand and on order for each product of one supplier, at the end of the given date.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string",
            "title": "Supplier",
            "description": "Supplier identifier, for example supplier-x.",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Stock snapshot date (YYYY-MM-DD).",
            "title": "Date"
          }
        },
        "required": [
          "supplier_id",
          "date"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "supplier": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "unit": {
                  "type": "string",
                  "description": "Ordering unit, for example case."
                },
                "pack_size": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Items per ordering unit."
                },
                "on_hand": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Ordering units on hand."
                },
                "on_order": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Ordering units ordered but not yet delivered."
                },
                "reorder_point": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Stock level, in ordering units, at or below which the product should be reordered."
                }
              },
              "required": [
                "sku",
                "name",
                "unit",
                "pack_size",
                "on_hand",
                "on_order",
                "reorder_point"
              ]
            }
          }
        },
        "required": [
          "supplier",
          "date",
          "products"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_sales_history",
      "title": "Sales history",
      "description": "Ordering units (for example cases) sold per day for each product of one supplier over an inclusive date range of at most 31 days.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string",
            "title": "Supplier",
            "description": "Supplier identifier, for example supplier-x.",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "First day of the period (YYYY-MM-DD), inclusive.",
            "title": "From"
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Last day of the period (YYYY-MM-DD), inclusive.",
            "title": "To"
          }
        },
        "required": [
          "supplier_id",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "total_units": {
                  "type": "integer",
                  "minimum": 0
                },
                "days": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "units": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "date",
                      "units"
                    ]
                  }
                }
              },
              "required": [
                "sku",
                "total_units",
                "days"
              ]
            }
          }
        },
        "required": [
          "supplier_id",
          "from",
          "to",
          "products"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "create_draft_order",
      "title": "Create draft order",
      "description": "Saves a draft purchase order for review. The draft is not submitted to the supplier and no stock, payment or external system changes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string",
            "title": "Supplier",
            "description": "Supplier identifier, for example supplier-x.",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Requested delivery date (YYYY-MM-DD).",
            "title": "Delivery date"
          },
          "lines": {
            "type": "array",
            "title": "Order lines",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "title": "SKU",
                  "description": "Product SKU from get_stock_levels."
                },
                "quantity": {
                  "type": "integer",
                  "title": "Quantity",
                  "description": "Number of ordering units (for example cases).",
                  "minimum": 1,
                  "maximum": 1000
                },
                "rationale": {
                  "type": "string",
                  "title": "Rationale",
                  "description": "Why this quantity is proposed.",
                  "maxLength": 500
                }
              },
              "required": [
                "sku",
                "quantity",
                "rationale"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "description": "Optional notes for the reviewer.",
            "maxLength": 1000
          }
        },
        "required": [
          "supplier_id",
          "delivery_date",
          "lines"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "draft_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "draft"
          },
          "submitted": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "draft_id",
          "status",
          "submitted"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    }
  ],
